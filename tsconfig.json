{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "@providers/*": ["src/providers/*"],
      "@data-hub/*": ["src/data-hub/*"],
      "@governance/*": ["src/governance/*"],
      "@dashboard/*": ["src/dashboard/*"],
      "@tests/*": ["src/tests/*"]
    },
    "resolveJsonModule": true,
    "allowJs": false
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}
