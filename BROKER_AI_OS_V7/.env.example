# ─────────────────────────────────────────────────────────────────────────────
# BROKER_AI_OS_V7 — EXAMPLE environment file.
# Copy to ".env" and fill in real values. Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

PORT=6060
SYSTEM_NAME=BROKER_AI_OS_V7
EXECUTION_MODE=manual
AUTO_RESUME=false
DATA_MODE=mock
NODE_ENV=production

# ── Alpaca READ-ONLY ──────────────────────────────────────────────────────────
# When both keys are present, the system performs REAL read-only HTTP probes.
# Use PAPER account keys only. No live/funded account keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_PAPER=true
ALPACA_READ_ONLY=true
ALPACA_NETWORK_ENABLED=true
ALPACA_MOCK_MODE=false

# ── Other providers (optional) ────────────────────────────────────────────────
NEWS_API_KEY=
ECON_CALENDAR_API_KEY=
CONGRESS_API_KEY=
INSIDER_API_KEY=
THIRTEEN_F_API_KEY=
