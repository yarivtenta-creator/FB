# ─────────────────────────────────────────────────────────────────────────────
# BROKER_AI_OS_V7 — EXAMPLE environment file.
# Copy to ".env" and fill in real values. Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

PORT=6060
SYSTEM_NAME=BROKER_AI_OS_V7
EXECUTION_MODE=manual
AUTO_RESUME=false
DATA_MODE=mock
NODE_ENV=production

# ── Alpaca READ-ONLY (market data + paper account status) ────────────────────
# These keys drive: the Alpaca Test button, market data, AND the equity figure
# used to size paper positions across all strategy slots.
# Use PAPER account keys only. Never live/funded account keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_PAPER=true
ALPACA_READ_ONLY=true
ALPACA_NETWORK_ENABLED=true
ALPACA_MOCK_MODE=false

# ═════════════════════════════════════════════════════════════════════════════
# STRATEGY ENGINE — 12 slots (A..L), 12 strategies available.
#
# The keys above are enough to activate ALL 12 slots. Per-slot keys below are
# OPTIONAL — set them only if you want a slot bound to a different paper account.
#
# Available strategies:
#   conservative  balanced      aggressive      momentum
#   mean_reversion insider_follow congress_follow institutional_13f
#   high_conviction diversified  swing           contrarian
#
# Disable any slot with SLOT_<ID>_ENABLED=false
# ═════════════════════════════════════════════════════════════════════════════

STRATEGY_A=conservative
STRATEGY_B=balanced
STRATEGY_C=aggressive
STRATEGY_D=momentum
STRATEGY_E=mean_reversion
STRATEGY_F=insider_follow
STRATEGY_G=congress_follow
STRATEGY_H=institutional_13f
STRATEGY_I=high_conviction
STRATEGY_J=diversified
STRATEGY_K=swing
STRATEGY_L=contrarian

# ── Optional: bind specific slots to specific paper accounts ─────────────────
# Example for your 3 Alpaca paper accounts:
# ALPACA_A_KEY_ID=          # 1 design      (PA3WU14Q176I)
# ALPACA_A_SECRET=
# ALPACA_B_KEY_ID=          # All Safe      (PA3V7EOMBCS3)
# ALPACA_B_SECRET=
# ALPACA_C_KEY_ID=          # All Safe      (PA3M60SPCLKV)
# ALPACA_C_SECRET=


# ═════════════════════════════════════════════════════════════════════════════
# MORE DATA PROVIDERS — all READ-ONLY research. None enables order placement.
#
# 5 providers need NO KEY and work the moment you start the server:
#   SEC EDGAR · US Treasury · CoinGecko · Binance Public · Frankfurter FX
#
# Below are FREE keys (no credit card). Fill in any you want — each one you add
# lights up another provider. Blank = that provider stays mock.
# ═════════════════════════════════════════════════════════════════════════════

# FRED — 800k economic series (CPI, GDP, rates). Unlimited free.
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Finnhub — quotes, fundamentals, earnings, news. 60 req/min free.
# https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage — quotes, indicators, FX, crypto. 25 req/day free.
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Twelve Data — stocks, forex, crypto, indicators. 800 req/day free.
# https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# Polygon.io — stocks, options, forex, crypto. 5 req/min free.
# https://polygon.io/dashboard/signup
POLYGON_API_KEY=

# Tiingo — EOD prices, news, fundamentals. 500 req/hr free.
# https://www.tiingo.com/account/api/token
TIINGO_API_KEY=

# Financial Modeling Prep — financials, ratios, DCF. 250 req/day free.
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Marketaux — financial news with sentiment. 100 req/day free.
# https://www.marketaux.com/register
MARKETAUX_API_KEY=

# CoinMarketCap — crypto prices, market cap. 10k credits/mo free.
# https://pro.coinmarketcap.com/signup
COINMARKETCAP_API_KEY=

# Etherscan — ETH txs, whale movements. 5 req/sec free.
# https://etherscan.io/register
ETHERSCAN_API_KEY=

# CoinGecko — optional; raises the keyless rate limit.
# https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# ── Original providers ────────────────────────────────────────────────────────
NEWS_API_KEY=
ECON_CALENDAR_API_KEY=
CONGRESS_API_KEY=
INSIDER_API_KEY=
THIRTEEN_F_API_KEY=
