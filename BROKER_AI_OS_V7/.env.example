# ─────────────────────────────────────────────────────────────────────────────
# BROKER_AI_OS_V7 — EXAMPLE environment file.
#
# SAFETY:
#   - Copy this file to ".env" and fill values LOCALLY.
#   - The real ".env" is git-ignored. NEVER commit real keys.
#   - Alpaca is READ-ONLY in this system. No orders, no execution, no positions modification.
#   - DATA_MODE=live enables real market data reads only. No live trading path exists.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=6060
EXECUTION_MODE=manual        # manual | auto-paper | off  (NO live mode exists)
AUTO_RESUME=false
DATA_MODE=mock               # mock | live  (live = read-only market data only)
NODE_ENV=production

# ── Alpaca READ-ONLY (market data + account status) ───────────────────────────
# Leave blank to use mock data. Presence of both keys activates real Alpaca reads.
# Use Alpaca PAPER account keys only. Never use live/funded account keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_PAPER=true
ALPACA_READ_ONLY=true

# ── Legacy key names (also supported) ────────────────────────────────────────
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# ── Other providers (optional, all blank by default) ─────────────────────────
NEWS_API_KEY=
ECON_CALENDAR_API_KEY=
CONGRESS_API_KEY=
INSIDER_API_KEY=
THIRTEEN_F_API_KEY=
