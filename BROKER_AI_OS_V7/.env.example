# ─────────────────────────────────────────────────────────────────────────────
# Broker AI OS v5 (port 6700) — EXAMPLE environment file.
#
# SAFETY:
#   - This is a TEMPLATE ONLY. Copy to ".env" and fill values LOCALLY.
#   - The real ".env" is git-ignored (see .gitignore) and must NEVER be committed.
#   - NO real keys belong in this file. Placeholders only.
#   - DATA_MODE controls the DATA path only. There is NO live execution path anywhere.
#   - Even in DATA_MODE=live, adapters are READ-ONLY (quotes/bars/status). No orders.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime (non-secret flags) ───────────────────────────────────────────────
PORT_V5=6700
EXECUTION_MODE=manual          # manual | auto-paper | off   (there is NO "live")
AUTO_RESUME=false              # only the literal "true" enables resume
DATA_MODE=mock                 # mock | live   (live = read-only data only)

# ── Alpaca (READ-ONLY market data / account status only) ─────────────────────
# Leave blank to keep Alpaca disabled. Presence (not value) flips "configured:true".
# Use the *paper / data* base URL. NEVER a trading/execution endpoint.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# ── Other providers (read-only; optional, all blank by default) ──────────────
NEWS_API_KEY=
ECON_CALENDAR_API_KEY=
CONGRESS_API_KEY=
INSIDER_API_KEY=
THIRTEEN_F_API_KEY=

# NOTE: T4 / Plus500 are DATA/STATUS ONLY in this system. There is intentionally
# no execution credential and no FIX configuration. Do not add one.

# ── 3-ACCOUNT STRATEGY ENGINE (paper only, read-only data) ───────────────────
# Each account = one Alpaca PAPER account running one strategy, all in this system.
# Keys are read-only market-data keys. Presence flips the account to "configured".
# Strategies: conservative (most secure) | balanced | aggressive
ALPACA_A_KEY_ID=
ALPACA_A_SECRET=
STRATEGY_A=conservative

ALPACA_B_KEY_ID=
ALPACA_B_SECRET=
STRATEGY_B=balanced

ALPACA_C_KEY_ID=
ALPACA_C_SECRET=
STRATEGY_C=aggressive
