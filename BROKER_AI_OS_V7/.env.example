# ═══════════════════════════════════════════════════════════════════════════
#  BROKER_AI_OS_V7  —  YOUR REAL .env FILE
#
#  ►► PUT YOUR ALPACA KEYS ON LINES 18 AND 22 (marked with ►►) ◄◄
#
#  Everything else already works. You do not need to change anything else.
#  Save this file, then restart the server.
# ═══════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════
#  STEP 1 — PASTE YOUR TWO ALPACA PAPER KEYS HERE
#
#  Get them at: https://app.alpaca.markets/paper/dashboard/overview
#  (Make sure the toggle says PAPER, not Live. Your key must start with PK)
# ═══════════════════════════════════════════════════════════════════════════

# ►► PASTE "API Key ID" HERE (starts with PK) — no quotes, no spaces
ALPACA_API_KEY=


# ►► PASTE "Secret Key" HERE (~40 characters) — no quotes, no spaces
ALPACA_SECRET_KEY=


#  Correct example of what it should look like when filled in:
#     ALPACA_API_KEY=PKA1B2C3D4E5F6G7H8I9
#     ALPACA_SECRET_KEY=aB3dEf6HiJkLmN0pQrStUvWxYz1234567890AbCd
#
#  WRONG — do not do these:
#     ALPACA_API_KEY="PKA1B2..."     <- no quotes
#     ALPACA_API_KEY = PKA1B2...     <- no spaces around =
#     ALPACA_API_KEY=AKA1B2...       <- AK = LIVE key. Wrong. Use the PK one.


# ═══════════════════════════════════════════════════════════════════════════
#  THAT'S IT. Nothing below needs editing.
# ═══════════════════════════════════════════════════════════════════════════


# ── Alpaca endpoints (paper only — do not change) ──────────────────────────
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_PAPER=true
ALPACA_READ_ONLY=true
ALPACA_NETWORK_ENABLED=true
ALPACA_MOCK_MODE=false

# ── Server ─────────────────────────────────────────────────────────────────
PORT=6060
SYSTEM_NAME=BROKER_AI_OS_V7
EXECUTION_MODE=manual
AUTO_RESUME=false
DATA_MODE=mock
NODE_ENV=production

# ── SEC EDGAR requires a contact email (their policy). Yours is prefilled. ──
SEC_USER_AGENT=BROKER_AI_OS_V7 research yariv.tenta@gmail.com


# ═══════════════════════════════════════════════════════════════════════════
#  OPTIONAL — FREE EXTRA DATA KEYS
#
#  All optional. Leave blank and the system still runs fine.
#  Each one you fill in lights up another provider on the dashboard.
#  All free, no credit card.
# ═══════════════════════════════════════════════════════════════════════════

# FRED — 800k economic series (CPI, GDP, rates). Unlimited free. BEST ONE.
# Get key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Finnhub — quotes, fundamentals, earnings, news. 60/min free. SECOND BEST.
# Get key: https://finnhub.io/register
FINNHUB_API_KEY=

# Twelve Data — stocks, forex, crypto, indicators. 800/day free.
# Get key: https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# Tiingo — EOD prices, news, fundamentals. 500/hr free.
# Get key: https://www.tiingo.com/account/api/token
TIINGO_API_KEY=

# Financial Modeling Prep — financials, ratios, DCF. 250/day free.
# Get key: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Etherscan — ETH transactions, whale movements. 5/sec free.
# Get key: https://etherscan.io/register
ETHERSCAN_API_KEY=

# CoinMarketCap — crypto prices, market cap. 10k credits/mo free.
# Get key: https://pro.coinmarketcap.com/signup
COINMARKETCAP_API_KEY=

# Marketaux — financial news with sentiment. 100/day free.
# Get key: https://www.marketaux.com/register
MARKETAUX_API_KEY=

# Polygon.io — stocks, options, forex, crypto. 5/min free.
# Get key: https://polygon.io/dashboard/signup
POLYGON_API_KEY=

# Alpha Vantage — quotes, indicators, FX. 25/day free.
# Get key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# CoinGecko — optional, raises the free rate limit.
# Get key: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# NewsAPI — headlines. 100/day free.
# Get key: https://newsapi.org/register
NEWS_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════
#  OPTIONAL — per-strategy accounts
#
#  Leave blank. The keys at the top already power all 12 strategies.
#  Only fill these if you want specific slots on different paper accounts.
#
#  Your paper accounts:
#    1 design   PA3WU14Q176I
#    All Safe   PA3V7EOMBCS3
#    All Safe   PA3M60SPCLKV
# ═══════════════════════════════════════════════════════════════════════════

ALPACA_A_KEY_ID=
ALPACA_A_SECRET=
ALPACA_B_KEY_ID=
ALPACA_B_SECRET=
ALPACA_C_KEY_ID=
ALPACA_C_SECRET=


# ═══════════════════════════════════════════════════════════════════════════
#  OPTION B — send real orders to your Alpaca PAPER account
#
#  OFF by default. While this is false the system only SIMULATES trades and
#  your Alpaca paper balance never moves.
#
#  Set to true and the strategy engine submits each new trade as a market
#  order to your PAPER account, so the balance and positions really change.
#  Still play money — but it is your real Alpaca paper account.
#
#  Four guards below cannot be turned off. Live trading stays impossible:
#    - base URL must be paper-api.alpaca.markets
#    - API key must start with PK (live keys start with AK and are refused)
#    - account number must start with PA
#    - key and secret must both be present
#  Check http://localhost:6060/api/alpaca-exec/status to see which guard
#  is blocking, if any.
# ═══════════════════════════════════════════════════════════════════════════

ALPACA_EXECUTE=false


# ═══════════════════════════════════════════════════════════════════════════
#  AI-Trader (ai4trade.ai) — community trading signal feed
#
#  Optional. Register a free agent at https://ai4trade.ai to get a token,
#  then paste it below. The system reads the signal feed and turns it into
#  research signals that flow into scoring and statistics.
#
#  It never publishes your trades to AI-Trader.
#
#  AITRADER_SCORE is the conviction score given to every AI-Trader signal.
#  The feed does not supply one, so this is a flat, honest baseline rather
#  than an invented per-signal number. Default 0.60.
# ═══════════════════════════════════════════════════════════════════════════

AITRADER_TOKEN=
AITRADER_SCORE=0.60
